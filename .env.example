# AutoTube AI Video Generator - Environment Variables
# Copy this file to .env.local and fill in your API keys
#
# SECURITY: Every VITE_* value is embedded in the browser build and is public.
# Never put production secrets in VITE_* variables; use server-side variables.

# Server-side OpenRouter key (preferred). Used by /api/llm and quality-check.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional BYOK fallback for local UI only. This is exposed in browser builds.
# Never use it for a production secret; prefer OPENROUTER_API_KEY on the server.
VITE_OPENROUTER_KEY=

# Optional: generation model overrides (default xiaomi/mimo-v2.5)
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Optional: independent blind-judge model for the video watcher / cold eval.
# Set this to a vision-capable model DIFFERENT from generation so cold-eval
# scores are not self-graded (same-model judge inflates confidence).
# When unset during cold eval (AUTOTUBE_EVAL_COLD=1) the watcher defaults to an
# independent model (google/gemini-2.5-flash). See eval/JUDGE-LIMITATION.md.
AUTOTUBE_WATCH_MODEL=

# API gate — required in every environment (dev included; /api/health stays public).
# `npm run dev` reads this from .env.local; clients send it back as X-API-Key.
AUTOTUBE_API_KEY=

# Prefills the browser Settings key so local dev / Playwright can call /api/*.
# Set it to the same value as AUTOTUBE_API_KEY locally; never set it in a
# production build (VITE_* values are public).
VITE_AUTOTUBE_API_KEY=

# Optional: Serper API key for Google image search
# Server-side (preferred in production): used by /api/search-google-images when scraping fails.
# Get from: https://serper.dev/
SERPER_API_KEY=
# LOCAL BYOK ONLY — this is embedded in browser builds and is public.
# Prefer server-side SERPER_API_KEY in production; do not set VITE_SERPER_KEY in prod builds.
VITE_SERPER_KEY=

# Optional: Firecrawl API key for web scraping (unused by current app path)
VITE_FIRECRAWL_KEY=

# xAI API key for Grok TTS narration (high quality)
# Server-side (preferred in production): used by /api/tts/grok proxy.
# Get from: https://console.x.ai/
XAI_API_KEY=
# LOCAL BYOK ONLY — this is embedded in browser builds and is public.
# Set XAI_API_KEY on the server instead; the browser proxy (/api/tts/grok) will use it.
# Only set VITE_XAI_KEY for local development when running without the full server stack.
VITE_XAI_KEY=

# Cloudflare account ID and API token for MeloTTS (cheap TTS fallback)
# Server-side (preferred in production): used by /api/tts/melo proxy.
# Get from: https://dash.cloudflare.com/ → Workers AI → Use REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=
# LOCAL BYOK ONLY — these are embedded in browser builds and are public.
# Set CF_ACCOUNT_ID / CF_API_TOKEN on the server instead; the proxy (/api/tts/melo) will use them.
# Only set VITE_CF_* for local development when running without the full server stack.
VITE_CF_ACCOUNT_ID=
VITE_CF_API_TOKEN=

# Optional: Self-hosted Kokoro TTS service URL (deploy tts-service/ on Railway)
# Leave empty to use local Kokoro Python or edge-tts fallback
KOKORO_SERVER_URL=

# Stock media API keys
# Server-side (preferred in production): used by /api/search-pexels and /api/search-pixabay proxies.
# When set server-side, the browser never needs VITE_PEXELS_KEY / VITE_PIXABAY_KEY.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# LOCAL BYOK ONLY — these are embedded in browser builds and are public.
# Set PEXELS_API_KEY / PIXABAY_API_KEY on the server instead.
# Only set VITE_* variants for local development without the full server stack.
VITE_PEXELS_KEY=
VITE_PIXABAY_KEY=
